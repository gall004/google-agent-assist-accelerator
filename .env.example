# ===========================================================================
# Google Agent Assist Accelerator — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env, .env.local, or .env.prod to version control.
# ===========================================================================

# --- GCP Configuration ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# --- Redis (Memorystore) ---
REDIS_HOST=redis://localhost:6379
REDIS_PORT=6379

# --- UI Connector ---
# JWT secret for generating temporary tokens for authenticated agent desktops.
# In production, this is fetched from Google Secret Manager at runtime.
JWT_SECRET_KEY=your-jwt-secret-key-for-local-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=1

# --- CORS ---
# Comma-separated list of allowed origins. Never use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Dialogflow ---
DIALOGFLOW_CX_LOCATION=global
CONVERSATION_PROFILE=projects/your-project-id/locations/global/conversationProfiles/your-profile-id

# --- Pub/Sub ---
PUBSUB_HUMAN_AGENT_ASSISTANT_TOPIC=human-agent-assistant-event
PUBSUB_CONVERSATION_LIFECYCLE_TOPIC=conversation-lifecycle-event
PUBSUB_NEW_MESSAGE_TOPIC=new-message-event
PUBSUB_RECOGNITION_RESULT_TOPIC=new-recognition-result-notification-event

# --- UI (React) ---
# Variables prefixed with VITE_ are exposed to the browser bundle.
VITE_UI_CONNECTOR_URL=http://localhost:8080
VITE_DIALOGFLOW_LOCATION=global
